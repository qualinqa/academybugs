  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.14.1",
    "allure-playwright": "^3.2.1"
  },
  "dependencies": {
    "dotenv": "^16.5.0"
  }
