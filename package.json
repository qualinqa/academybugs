{
  "name": "academybugs",
  "version": "1.0.0",
  "type": "module",
  "description": "academybugs.com",
  "main": "index.js",
  "scripts": {
    "test": " npx playwright test",
    "ui": "npx playwright test --ui",
    "reportAwesome": "npx allure awesome ./allure-results --single-file",
    "reportClassic": "npx allure classic ./allure-results --single-file",
    "codegen": "npx playwright codegen https://academybugs.com/find-bugs/#",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:serve": "npx allure serve allure-results",
    "allure:history": "node scripts/allure-history.js"
  },
